server {
    listen 80;
    listen [::]:80;
    server_name tour-armenia.com www.tour-armenia.com;
    return 301 https://tour-armenia.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.tour-armenia.com;

    ssl_certificate /etc/letsencrypt/live/tour-armenia.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tour-armenia.com/privkey.pem;
    return 301 https://tour-armenia.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tour-armenia.com;

    ssl_certificate /etc/letsencrypt/live/tour-armenia.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tour-armenia.com/privkey.pem;

    client_max_body_size 105m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
